{
  "name": "@owdproject/core",
  "version": "4.0.0-alpha.3",
  "description": "Headless desktop engine for the web: windows, applications, workspaces, commands, hooks, IPC, and pointer math",
  "homepage": "https://github.com/owdproject/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owdproject/core.git"
  },
  "author": {
    "name": "Diego Villa (@dxlliv)",
    "url": "https://github.com/dxlliv"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./machines": {
      "types": "./dist/machines/index.d.ts",
      "import": "./dist/machines/index.mjs",
      "default": "./dist/machines/index.mjs"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.mjs",
      "default": "./dist/layout/index.mjs"
    },
    "./managers": {
      "types": "./dist/managers/index.d.ts",
      "import": "./dist/managers/index.mjs",
      "default": "./dist/managers/index.mjs"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.mjs",
      "default": "./dist/events/index.mjs"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "import": "./dist/session/index.mjs",
      "default": "./dist/session/index.mjs"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.mjs",
      "default": "./dist/dom/index.mjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "default": "./dist/types/index.mjs"
    }
  },
  "dependencies": {
    "getopts": "^2.3.0",
    "hookable": "^6.1.2",
    "nanoid": "^6.0.2",
    "shellwords": "^1.1.1",
    "xstate": "^5.33.3"
  },
  "devDependencies": {
    "unbuild": "^3.6.1",
    "typescript": "~6.0.3",
    "@types/getopts": "^2.1.0"
  },
  "scripts": {
    "build": "unbuild",
    "prepack": "unbuild"
  }
}
